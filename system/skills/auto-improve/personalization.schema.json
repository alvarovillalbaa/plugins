{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auto Improve Personalization",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "company": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "website": { "type": "string" },
        "tone": { "type": "string" }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "workflow": {
      "type": "object",
      "required": ["plugin_improvement_scope"],
      "additionalProperties": false,
      "properties": {
        "preferred_agent": { "type": "string" },
        "plugin_improvement_scope": { "const": "installed-copy" }
      }
    }
  }
}
